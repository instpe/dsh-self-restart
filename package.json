{
  "name": "@instpe/dsh-self-restart",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH plugin: a session agent restarts its own host process and receives a message in the same session once it is back. · 会话智能体自重启：重启宿主进程，并在重启完成后向原会话投递一条消息。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "self-restart",
    "session-continuation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/instpe/dsh-self-restart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instpe/dsh-self-restart.git"
  },
  "bugs": {
    "url": "https://github.com/instpe/dsh-self-restart/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "restart.js",
    "client.js",
    "cordis.patch.yml",
    "docs/design.md",
    "README.md",
    "test/smoke.mjs"
  ],
  "meta": {
    "title": "自重启",
    "description": "允许会话智能体重启宿主进程，重启完成后在自身会话内收到一条消息。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
